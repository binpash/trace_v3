// Apples-to-apples bpftrace dependency tracer for the trace_v3 comparison.
//
// Hooks the same syscall set that trace_v3 actively handles in dep_tracer.rs
// (parse_openat / parse_chdir / parse_r_*_path_e1 / parse_w_*_path_e1 / dup /
// dup3 / pipe2 / renameat[2] / fcntl / clone). Emits one TSV-formatted line
// per syscall enter and exit, to be consumed by post_process.py which builds
// the same fd-table + cwd + ancestor-closure model trace_v3 builds in Rust.
//
// Usage:
//   BPFTRACE_STRLEN=4096 bpftrace -B none -c 'CMD ARGS' trace_deps.bt > events.log
//
// Output schema (TAB-separated; paths are always last so embedded tabs are
// preserved through the post-processor's split-with-maxsplit):
//   E1<tab>syscall<tab>pid<tab>tid<tab>dfd<tab>flags<tab>mode<tab>path
//   E2<tab>syscall<tab>pid<tab>tid<tab>dfd<tab>dfd2<tab>flags<tab>path1<tab>path2
//   E0<tab>syscall<tab>pid<tab>tid<tab>fd<tab>fd2<tab>flags<tab>cmd<tab>arg
//   X<tab>syscall<tab>pid<tab>tid<tab>ret
//   F<tab>parent_pid<tab>child_pid
//   T<tab>pid                          (process exit)

BEGIN {
        @desc[cpid] = 1;
}

// ---------- process tree -----------------------------------------------------

tracepoint:sched:sched_process_fork
/@desc[args->parent_pid]/
{
        @desc[args->child_pid] = 1;
        printf("F\t%d\t%d\n", args->parent_pid, args->child_pid);
}

tracepoint:sched:sched_process_exit
/@desc[pid]/
{
        printf("T\t%d\n", pid);
        delete(@desc[pid]);
}

// ---------- one-path read/write syscalls (no dirfd) --------------------------

tracepoint:syscalls:sys_enter_open
/@desc[pid]/
{
        printf("E1\topen\t%d\t%d\t-100\t%d\t0\t%s\n",
               pid, tid, args->flags, str(args->filename));
}
tracepoint:syscalls:sys_exit_open  /@desc[pid]/ { printf("X\topen\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_chdir
/@desc[pid]/
{
        printf("E1\tchdir\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->filename));
}
tracepoint:syscalls:sys_exit_chdir /@desc[pid]/ { printf("X\tchdir\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_execve
/@desc[pid]/
{
        printf("E1\texecve\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->filename));
}
tracepoint:syscalls:sys_exit_execve /@desc[pid]/ { printf("X\texecve\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_statfs
/@desc[pid]/
{
        printf("E1\tstatfs\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->pathname));
}
tracepoint:syscalls:sys_exit_statfs /@desc[pid]/ { printf("X\tstatfs\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_getxattr
/@desc[pid]/
{
        printf("E1\tgetxattr\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->pathname));
}
tracepoint:syscalls:sys_exit_getxattr /@desc[pid]/ { printf("X\tgetxattr\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_lgetxattr
/@desc[pid]/
{
        printf("E1\tlgetxattr\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->pathname));
}
tracepoint:syscalls:sys_exit_lgetxattr /@desc[pid]/ { printf("X\tlgetxattr\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_truncate
/@desc[pid]/
{
        printf("E1\ttruncate\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->path));
}
tracepoint:syscalls:sys_exit_truncate /@desc[pid]/ { printf("X\ttruncate\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_acct
/@desc[pid]/
{
        printf("E1\tacct\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->name));
}
tracepoint:syscalls:sys_exit_acct /@desc[pid]/ { printf("X\tacct\t%d\t%d\t%ld\n", pid, tid, args->ret); }

