tracepoint:syscalls:sys_exit_symlinkat /@desc[pid]/ { printf("X\tsymlinkat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

// ---------- two-path syscalls -----------------------------------------------

tracepoint:syscalls:sys_enter_renameat
/@desc[pid]/
{
        printf("E2\trenameat\t%d\t%d\t%d\t%d\t0\t%s\t%s\n",
               pid, tid, args->olddfd, args->newdfd,
               str(args->oldname), str(args->newname));
}
tracepoint:syscalls:sys_exit_renameat /@desc[pid]/ { printf("X\trenameat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_renameat2
/@desc[pid]/
{
        printf("E2\trenameat2\t%d\t%d\t%d\t%d\t%d\t%s\t%s\n",
               pid, tid, args->olddfd, args->newdfd, args->flags,
               str(args->oldname), str(args->newname));
}
tracepoint:syscalls:sys_exit_renameat2 /@desc[pid]/ { printf("X\trenameat2\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_linkat
/@desc[pid]/
{
        printf("E2\tlinkat\t%d\t%d\t%d\t%d\t%d\t%s\t%s\n",
               pid, tid, args->olddfd, args->newdfd, args->flags,
               str(args->oldname), str(args->newname));
}
tracepoint:syscalls:sys_exit_linkat /@desc[pid]/ { printf("X\tlinkat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

// ---------- fd-only syscalls (no path) --------------------------------------

tracepoint:syscalls:sys_enter_dup
/@desc[pid]/
{
        printf("E0\tdup\t%d\t%d\t%d\t-1\t0\t0\t0\n",
               pid, tid, args->fildes);
}
tracepoint:syscalls:sys_exit_dup /@desc[pid]/ { printf("X\tdup\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_dup2
/@desc[pid]/
{
        printf("E0\tdup2\t%d\t%d\t%d\t%d\t0\t0\t0\n",
               pid, tid, args->oldfd, args->newfd);
}
tracepoint:syscalls:sys_exit_dup2 /@desc[pid]/ { printf("X\tdup2\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_dup3
/@desc[pid]/
{
        printf("E0\tdup3\t%d\t%d\t%d\t%d\t%d\t0\t0\n",
               pid, tid, args->oldfd, args->newfd, args->flags);
}
tracepoint:syscalls:sys_exit_dup3 /@desc[pid]/ { printf("X\tdup3\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_fcntl
/@desc[pid]/
{
        printf("E0\tfcntl\t%d\t%d\t%d\t-1\t0\t%d\t%lu\n",
               pid, tid, args->fd, args->cmd, args->arg);
}
tracepoint:syscalls:sys_exit_fcntl /@desc[pid]/ { printf("X\tfcntl\t%d\t%d\t%ld\n", pid, tid, args->ret); }

// memfd_create produces a virtual path; we just emit the name field and let
// the post-processor stitch the /memfd:: prefix on the open_file entry.
tracepoint:syscalls:sys_enter_memfd_create
/@desc[pid]/
{
        printf("E1\tmemfd_create\t%d\t%d\t-100\t%d\t0\t%s\n",
               pid, tid, args->flags, str(args->uname));
}
tracepoint:syscalls:sys_exit_memfd_create /@desc[pid]/ { printf("X\tmemfd_create\t%d\t%d\t%ld\n", pid, tid, args->ret); }

END {
        clear(@desc);
}
