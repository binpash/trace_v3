tracepoint:syscalls:sys_exit_name_to_handle_at /@desc[pid]/ { printf("X\tname_to_handle_at\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_readlinkat
/@desc[pid]/
{
        printf("E1\treadlinkat\t%d\t%d\t%d\t0\t0\t%s\n",
               pid, tid, args->dfd, str(args->pathname));
}
tracepoint:syscalls:sys_exit_readlinkat /@desc[pid]/ { printf("X\treadlinkat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_faccessat
/@desc[pid]/
{
        printf("E1\tfaccessat\t%d\t%d\t%d\t0\t0\t%s\n",
               pid, tid, args->dfd, str(args->filename));
}
tracepoint:syscalls:sys_exit_faccessat /@desc[pid]/ { printf("X\tfaccessat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_faccessat2
/@desc[pid]/
{
        printf("E1\tfaccessat2\t%d\t%d\t%d\t%d\t0\t%s\n",
               pid, tid, args->dfd, args->flags, str(args->filename));
}
tracepoint:syscalls:sys_exit_faccessat2 /@desc[pid]/ { printf("X\tfaccessat2\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_execveat
/@desc[pid]/
{
        printf("E1\texecveat\t%d\t%d\t%d\t%d\t0\t%s\n",
               pid, tid, args->fd, args->flags, str(args->filename));
}
tracepoint:syscalls:sys_exit_execveat /@desc[pid]/ { printf("X\texecveat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_unlinkat
/@desc[pid]/
{
        printf("E1\tunlinkat\t%d\t%d\t%d\t%d\t0\t%s\n",
               pid, tid, args->dfd, args->flag, str(args->pathname));
}
tracepoint:syscalls:sys_exit_unlinkat /@desc[pid]/ { printf("X\tunlinkat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_utimensat
/@desc[pid]/
{
        printf("E1\tutimensat\t%d\t%d\t%d\t%d\t0\t%s\n",
               pid, tid, args->dfd, args->flags, str(args->filename));
}
tracepoint:syscalls:sys_exit_utimensat /@desc[pid]/ { printf("X\tutimensat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_mkdirat
/@desc[pid]/
{
        printf("E1\tmkdirat\t%d\t%d\t%d\t0\t%d\t%s\n",
               pid, tid, args->dfd, args->mode, str(args->pathname));
}
tracepoint:syscalls:sys_exit_mkdirat /@desc[pid]/ { printf("X\tmkdirat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_mknodat
/@desc[pid]/
{
        printf("E1\tmknodat\t%d\t%d\t%d\t0\t%d\t%s\n",
               pid, tid, args->dfd, args->mode, str(args->filename));
}
tracepoint:syscalls:sys_exit_mknodat /@desc[pid]/ { printf("X\tmknodat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_fchownat
/@desc[pid]/
{
        printf("E1\tfchownat\t%d\t%d\t%d\t%d\t0\t%s\n",
               pid, tid, args->dfd, args->flag, str(args->filename));
}
tracepoint:syscalls:sys_exit_fchownat /@desc[pid]/ { printf("X\tfchownat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_fchmodat
/@desc[pid]/
{
        printf("E1\tfchmodat\t%d\t%d\t%d\t0\t%d\t%s\n",
               pid, tid, args->dfd, args->mode, str(args->filename));
}
tracepoint:syscalls:sys_exit_fchmodat /@desc[pid]/ { printf("X\tfchmodat\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_inotify_add_watch
/@desc[pid]/
{
        printf("E1\tinotify_add_watch\t%d\t%d\t-100\t0\t0\t%s\n",
               pid, tid, str(args->pathname));
}
tracepoint:syscalls:sys_exit_inotify_add_watch /@desc[pid]/ { printf("X\tinotify_add_watch\t%d\t%d\t%ld\n", pid, tid, args->ret); }

tracepoint:syscalls:sys_enter_symlinkat
/@desc[pid]/
{
        printf("E1\tsymlinkat\t%d\t%d\t%d\t0\t0\t%s\n",
               pid, tid, args->newdfd, str(args->newname));
