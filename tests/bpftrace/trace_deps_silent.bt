// Probe-cost-only sibling of trace_deps.bt.
//
// Attaches the exact same tracepoints with the exact same per-pid filter,
// but every probe body just bumps a counter instead of doing the printf +
// str() + perf-buffer write that trace_deps.bt does. Comparing this against
// trace_deps.bt isolates how much of bpftrace's overhead is the text-printf
// transport (the gap) versus the kernel-side BPF instrumentation itself
// (this script's overhead vs baseline).
//
// Usage: same as trace_deps.bt — bpftrace -B none -q -c '/bin/sh wrapper' ...

BEGIN {
        @desc[cpid] = 1;
}

tracepoint:sched:sched_process_fork
/@desc[args->parent_pid]/
{
        @desc[args->child_pid] = 1;
        @c = count();
}

tracepoint:sched:sched_process_exit
/@desc[pid]/
{
        delete(@desc[pid]);
        @c = count();
}

// One-path syscalls (no dirfd).
tracepoint:syscalls:sys_enter_open      /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_open       /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_chdir     /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_chdir      /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_execve    /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_execve     /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_statfs    /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_statfs     /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_getxattr  /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_getxattr   /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_lgetxattr /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_lgetxattr  /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_truncate  /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_truncate   /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_acct      /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_acct       /@desc[pid]/ { @c = count(); }

// One-path syscalls with dirfd.
tracepoint:syscalls:sys_enter_openat            /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_openat             /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_newfstatat        /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_newfstatat         /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_statx             /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_statx              /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_name_to_handle_at /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_name_to_handle_at  /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_readlinkat        /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_readlinkat         /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_faccessat         /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_faccessat          /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_faccessat2        /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_faccessat2         /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_execveat          /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_execveat           /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_unlinkat          /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_unlinkat           /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_utimensat         /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_utimensat          /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_mkdirat           /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_mkdirat            /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_mknodat           /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_mknodat            /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_fchownat          /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_fchownat           /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_fchmodat          /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_fchmodat           /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_inotify_add_watch /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_inotify_add_watch  /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_symlinkat         /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_symlinkat          /@desc[pid]/ { @c = count(); }

// Two-path syscalls.
tracepoint:syscalls:sys_enter_renameat   /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_renameat    /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_renameat2  /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_renameat2   /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_linkat     /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_linkat      /@desc[pid]/ { @c = count(); }

// fd-only syscalls.
tracepoint:syscalls:sys_enter_dup     /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_dup      /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_dup2    /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_dup2     /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_dup3    /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_dup3     /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_fcntl   /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_fcntl    /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_enter_memfd_create /@desc[pid]/ { @c = count(); }
tracepoint:syscalls:sys_exit_memfd_create  /@desc[pid]/ { @c = count(); }

END {
        clear(@desc);
        clear(@c);
}
